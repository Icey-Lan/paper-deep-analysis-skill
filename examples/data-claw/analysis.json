  "concepts": [
    {
      "id": "concept-answer-identifiable-task",
      "term": "可辨识任务",
      "term_en": "Answer-identifiable task",
      "definition": "输入数据不仅能让正确实现运行，还必须让语义错误但可执行的实现产生不同结果，使 grader 真正具备区分对错的能力。",
      "plain_language": "不是只准备一套能跑通的数据，而是准备一套会主动暴露错误实现的数据。",
      "why_it_matters": "它降低了错误实现碰巧通过测试的概率，是 benchmark 数据质量的核心。",
      "attribution": "analyst_inference",
      "confidence": "high",
      "evidence_strength": "moderate",
      "anchors": [{"page": 4, "section": "3.1 Stage 3", "figure": "Figure 2", "table": null, "note": "扰动实现与差分执行"}],
      "tags": ["concept", "test-quality"]
    },
    {
      "id": "concept-artifact-evaluation",
      "term": "产物导向评测",
      "term_en": "Artifact-oriented evaluation",
      "definition": "执行 Agent 生成的代码并检查实际输出表，而不是比较生成代码与参考答案的文本相似度。",
      "plain_language": "验收最终交付的数据表，而不是只看 SQL 长得像不像标准答案。",
      "why_it_matters": "不同代码可能产生同样正确的业务结果；真实执行也能暴露文本审查无法发现的语义错误。",
      "attribution": "paper_claim",
      "confidence": "high",
      "evidence_strength": "strong",
      "anchors": [{"page": 5, "section": "3.2 Artifact-oriented evaluation", "figure": null, "table": null, "note": "产物评分维度"}],
      "tags": ["concept", "evaluation"]
    },
    {
      "id": "concept-process-evaluation",
      "term": "过程导向评测",
      "term_en": "Process-oriented evaluation",
      "definition": "评价 Agent 是否充分探索数据、避免无效重试并主动验证结果，用来识别偶然成功或不可复用的执行方式。",
      "plain_language": "不仅看结果有没有交付，也看它是否检查过字段、验证过结果，而不是靠反复试错碰巧成功。",
      "why_it_matters": "过程证据帮助区分稳定能力与偶然成功，也能定位 Harness 和工具层问题。",
      "attribution": "paper_claim",
      "confidence": "high",
      "evidence_strength": "moderate",
      "anchors": [{"page": 5, "section": "3.2 Process-oriented evaluation", "figure": null, "table": null, "note": "探索、效率和自验证"}],
      "tags": ["concept", "process"]
    },
    {
      "id": "concept-silent-data-error",
      "term": "静默数据错误",
      "term_en": "Silent data error",
      "definition": "程序成功执行并写出结果，但结果在 schema、行级、数值或业务逻辑上错误，且没有显式异常提醒。",
      "plain_language": "任务显示绿色成功，实际报表已经少数、错数或口径偏移。",
      "why_it_matters": "这类失败不会被运行状态发现，必须依靠数据契约、业务不变量和确定性验收。",
      "attribution": "analyst_inference",
      "confidence": "high",
      "evidence_strength": "strong",
      "anchors": [{"page": 13, "section": "Appendix B", "figure": "Figure 5", "table": "Table 5", "note": "102 个静默错误"}],
      "tags": ["concept", "data-quality"]
    }
  ],
