{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/paper-deep-analysis/learning-record.schema.json",
  "title": "Agent learning record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "paper_id",
    "paper_sha256",
    "record_type",
    "statement",
    "attribution",
    "confidence",
    "evidence_strength",
    "anchors",
    "tags",
    "relations",
    "source"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "record_id": {"type": "string", "pattern": "^[a-z0-9._-]+:[a-z][a-z0-9-]{2,79}$"},
    "paper_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "paper_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "record_type": {"enum": ["claim", "contribution", "method", "assumption", "limitation", "finding", "reproducibility", "profile_insight", "open_question"]},
    "statement": {"type": "string", "minLength": 1, "maxLength": 4000},
    "attribution": {"enum": ["paper_claim", "analyst_inference", "derived_lesson"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "evidence_strength": {"enum": ["strong", "moderate", "weak", "not_reported"]},
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "section", "figure", "table", "note"],
        "properties": {
          "page": {"type": ["integer", "null"], "minimum": 1},
          "section": {"type": ["string", "null"], "maxLength": 300},
          "figure": {"type": ["string", "null"], "maxLength": 100},
          "table": {"type": ["string", "null"], "maxLength": 100},
          "note": {"type": "string", "maxLength": 500}
        }
      }
    },
    "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,49}$"}, "uniqueItems": true},
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target_id"],
        "properties": {
          "type": {"enum": ["supports", "contradicts", "depends_on", "qualifies", "extends", "questions"]},
          "target_id": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "license"],
      "properties": {
        "url": {"type": ["string", "null"], "format": "uri"},
        "license": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
